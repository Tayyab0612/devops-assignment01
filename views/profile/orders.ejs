<%- include('../partials/header', { title: 'My Orders' }) %>
<div class="container" style="max-width:900px;padding-top:2rem">
  <div class="profile-layout">
    <aside class="profile-sidebar">
      <div class="profile-avatar">
        <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="<%= user.name %>"/>
        <% } else { %><div class="avatar-initials"><%= user.name.charAt(0).toUpperCase() %></div><% } %>
        <h3><%= user.name %></h3><p><%= user.email %></p>
      </div>
      <nav class="profile-nav">
        <a href="/profile"><i class="fas fa-user"></i> Profile</a>
        <a href="/profile/addresses"><i class="fas fa-map-marker-alt"></i> Addresses</a>
        <a href="/profile/orders" class="active"><i class="fas fa-box"></i> Orders</a>
        <a href="/orders"><i class="fas fa-receipt"></i> Order History</a>
      </nav>
    </aside>

    <div class="profile-content">
      <div class="profile-card">
        <h2><i class="fas fa-box"></i> Order History</h2>
        <% if (!orders.length) { %>
          <div style="text-align:center;padding:2rem;color:var(--text-light)">
            <i class="fas fa-box-open" style="font-size:3rem;opacity:.3"></i>
            <p style="margin-top:1rem">No orders yet.</p>
            <a href="/products" class="btn-primary" style="margin-top:1rem">Start Shopping</a>
          </div>
        <% } else { %>
          <% orders.forEach(order => { %>
            <div class="order-history-card">
              <div class="order-history-header">
                <div>
                  <strong style="font-size:1.1rem">#<%= order._id.toString().slice(-6).toUpperCase() %></strong>
                  <span style="color:var(--text-light);font-size:.85rem;margin-left:.75rem">
                    <%= new Date(order.createdAt).toLocaleDateString('en-PK',{year:'numeric',month:'long',day:'numeric'}) %>
                  </span>
                </div>
                <div style="display:flex;gap:.5rem;align-items:center">
                  <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
                  <span class="payment-badge payment-<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span>
                </div>
              </div>
              <div class="order-items-preview" style="margin:.75rem 0">
                <% order.items.slice(0,3).forEach(item => { %>
                  <div class="order-item-mini">
                    <img src="<%= item.image %>" onerror="this.src='/images/placeholder.svg'" alt="<%= item.name %>"/>
                    <span><%= item.name %> × <%= item.quantity %></span>
                  </div>
                <% }) %>
                <% if (order.items.length > 3) { %><span class="more-items">+<%= order.items.length-3 %> more</span><% } %>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding-top:.75rem">
                <strong>Total: Rs. <%= order.totalAmount.toLocaleString() %></strong>
                <div style="display:flex;gap:.5rem">
                  <a href="/orders/<%= order._id %>" class="btn-outline btn-sm">View Details</a>
                  <form action="/profile/reorder/<%= order._id %>" method="POST" style="margin:0">
                    <button type="submit" class="btn-primary btn-sm">
                      <i class="fas fa-redo"></i> Reorder
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
