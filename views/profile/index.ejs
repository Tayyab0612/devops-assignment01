<%- include('../partials/header', { title: 'My Profile' }) %>
<div class="container" style="max-width:900px;padding-top:2rem">
  <div class="profile-layout">
    <!-- Sidebar -->
    <aside class="profile-sidebar">
      <div class="profile-avatar">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.name %>"/>
        <% } else { %>
          <div class="avatar-initials"><%= user.name.charAt(0).toUpperCase() %></div>
        <% } %>
        <h3><%= user.name %></h3>
        <p><%= user.email %></p>
        <span class="role-badge <%= user.role %>"><%= user.role %></span>
      </div>
      <nav class="profile-nav">
        <a href="/profile" class="active"><i class="fas fa-user"></i> Profile</a>
        <a href="/profile/addresses"><i class="fas fa-map-marker-alt"></i> Addresses</a>
        <a href="/profile/orders"><i class="fas fa-box"></i> Orders</a>
        <a href="/orders"><i class="fas fa-receipt"></i> Order History</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="profile-content">
      <div class="profile-card">
        <h2><i class="fas fa-user-edit"></i> Edit Profile</h2>
        <form action="/profile/update" method="POST" class="profile-form">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="name" value="<%= user.name %>" required/>
          </div>
          <div class="form-group">
            <label>Email Address <small>(cannot be changed)</small></label>
            <input type="email" value="<%= user.email %>" disabled/>
          </div>
          <div class="form-group">
            <label>Phone Number <small>(for SMS order updates)</small></label>
            <input type="tel" name="phone" value="<%= user.phone || '' %>" placeholder="03xx-xxxxxxx"/>
          </div>
          <button type="submit" class="btn-primary">Save Changes</button>
        </form>
      </div>

      <% if (!user.googleId) { %>
      <div class="profile-card" style="margin-top:1.5rem">
        <h2><i class="fas fa-lock"></i> Change Password</h2>
        <form action="/profile/change-password" method="POST" class="profile-form">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" required/>
          </div>
          <div class="form-group">
            <label>New Password</label>
            <input type="password" name="newPassword" minlength="6" required/>
          </div>
          <div class="form-group">
            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" required/>
          </div>
          <button type="submit" class="btn-primary">Update Password</button>
        </form>
      </div>
      <% } %>

      <!-- Recent Orders Preview -->
      <div class="profile-card" style="margin-top:1.5rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
          <h2><i class="fas fa-box"></i> Recent Orders</h2>
          <a href="/profile/orders" class="btn-outline btn-sm">View All</a>
        </div>
        <% if (!orders.length) { %>
          <p style="color:var(--text-light);text-align:center;padding:1rem">No orders yet. <a href="/products">Start shopping!</a></p>
        <% } else { %>
          <% orders.forEach(order => { %>
            <div class="order-mini-row">
              <div>
                <strong>#<%= order._id.toString().slice(-6).toUpperCase() %></strong>
                <span style="color:var(--text-light);font-size:.85rem;margin-left:.5rem"><%= new Date(order.createdAt).toLocaleDateString('en-PK') %></span>
              </div>
              <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
              <strong>Rs. <%= order.totalAmount.toLocaleString() %></strong>
              <a href="/orders/<%= order._id %>" class="btn-outline btn-sm">View</a>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
