<%- include('../partials/header', { title: 'Order Details' }) %>
<div class="container">
  <div class="order-detail-header">
    <a href="/orders" class="back-link"><i class="fas fa-arrow-left"></i> Back to Orders</a>
    <h1>Order #<%= order._id.toString().slice(-6).toUpperCase() %></h1>
    <div class="order-badges">
      <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
      <span class="payment-badge payment-<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span>
    </div>
  </div>
  <div class="order-detail-layout">
    <div class="order-items-section">
      <h3>Items Ordered</h3>
      <% order.items.forEach(item => { %>
        <div class="order-item-row">
          <img src="<%= item.image %>" alt="<%= item.name %>" onerror="this.src='/images/placeholder.svg'"/>
          <div class="order-item-details">
            <h4><%= item.name %></h4>
            <p>Rs. <%= item.price.toLocaleString() %> × <%= item.quantity %></p>
          </div>
          <strong>Rs. <%= (item.price * item.quantity).toLocaleString() %></strong>
        </div>
      <% }) %>
      <div class="order-totals">
        <div class="summary-line"><span>Subtotal</span><span>Rs. <%= order.totalAmount.toLocaleString() %></span></div>
        <div class="summary-line"><span>Shipping</span><span>Included</span></div>
        <div class="summary-line total"><span>Total</span><span>Rs. <%= order.totalAmount.toLocaleString() %></span></div>
      </div>
    </div>
    <div class="order-sidebar">
      <div class="order-info-card">
        <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
        <p>
          <%= order.shippingAddress.street %><br/>
          <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zip %><br/>
          <%= order.shippingAddress.country %>
        </p>
      </div>
      <div class="order-info-card">
        <h3><i class="fas fa-money-bill"></i> Payment</h3>
        <p><%= order.paymentMethod %></p>
      </div>
      <div class="order-info-card">
        <h3><i class="fas fa-calendar"></i> Order Date</h3>
        <p><%= new Date(order.createdAt).toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %></p>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
