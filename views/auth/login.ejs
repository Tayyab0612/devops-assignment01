<%- include('../partials/header', { title: 'Login' }) %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <i class="fas fa-shopping-bag logo-icon"></i>
      <h2>Welcome Back</h2>
      <p>Login to your ShopZone account</p>
    </div>

   

    <form action="/auth/login" method="POST" class="auth-form">
      <div class="form-group">
        <label><i class="fas fa-envelope"></i> Email</label>
        <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"/>
      </div>
      <div class="form-group">
        <label><i class="fas fa-lock"></i> Password</label>
        <div class="password-wrap">
          <input type="password" name="password" id="password" placeholder="Your password" required autocomplete="current-password"/>
          <button type="button" class="toggle-pwd" onclick="togglePwd('password')"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <div class="form-group" style="text-align:right;">
        <a href="/auth/forgot" style="font-size:.9rem;color:var(--primary);">Forgot password?</a>
      </div>
      <button type="submit" class="btn-primary btn-full btn-lg">Login <i class="fas fa-arrow-right"></i></button>
    </form>

    <div class="auth-footer">
      <p>Don't have an account? <a href="/auth/register">Register here</a></p>
    </div>
  </div>
</div>

<script>
function togglePwd(id) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
}
</script>

<%- include('../partials/footer') %>
