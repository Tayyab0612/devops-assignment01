<%- include('../partials/header', { title: 'Reset Password' }) %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon-wrap green">
        <i class="fas fa-lock"></i>
      </div>
      <h2>Set New Password</h2>
      <p>Choose a strong password for your account</p>
    </div>

    <form action="/auth/reset/<%= token %>" method="POST" class="auth-form">
      <div class="form-group">
        <label><i class="fas fa-lock"></i> New Password</label>
        <div class="password-wrap">
          <input type="password" name="password" id="password" placeholder="Min. 6 characters" required minlength="6"/>
          <button type="button" class="toggle-pwd" onclick="togglePwd('password')"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <div class="form-group">
        <label><i class="fas fa-lock"></i> Confirm Password</label>
        <div class="password-wrap">
          <input type="password" name="confirm" id="confirm" placeholder="Repeat password" required/>
          <button type="button" class="toggle-pwd" onclick="togglePwd('confirm')"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <div class="password-strength">
        <div class="strength-bar" id="strengthBar"></div>
      </div>
      <button type="submit" class="btn-primary btn-full btn-lg">
        <i class="fas fa-check-circle"></i> Update Password
      </button>
    </form>

    <div class="auth-footer">
      <p><a href="/auth/login"><i class="fas fa-arrow-left"></i> Back to Login</a></p>
    </div>
  </div>
</div>

<script>
function togglePwd(id) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
}
document.getElementById('password').addEventListener('input', function() {
  const bar = document.getElementById('strengthBar');
  const len = this.value.length;
  const score = Math.min(100, len * 8 + ((/[A-Z]/.test(this.value))?10:0) + ((/[0-9]/.test(this.value))?10:0) + ((/[^a-zA-Z0-9]/.test(this.value))?20:0));
  bar.style.width = score + '%';
  bar.style.background = score < 40 ? '#ef4444' : score < 70 ? '#f59e0b' : '#10b981';
});
</script>

<%- include('../partials/footer') %>
