<%- include('../partials/header', { title: 'Admin Dashboard' }) %>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-brand"><i class="fas fa-shield-alt"></i> Admin Panel</div>
    <nav class="admin-nav">
      <a href="/admin/dashboard" class="active"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
      <a href="/admin/products"><i class="fas fa-box"></i> Products</a>
      <a href="/admin/orders"><i class="fas fa-receipt"></i> Orders</a>
      <a href="/products/admin/new"><i class="fas fa-plus"></i> Add Product</a>
      <a href="/"><i class="fas fa-store"></i> View Store</a>
    </nav>
  </aside>

  <div class="admin-content">
    <h1>Dashboard</h1>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card blue"><i class="fas fa-box"></i><div><span class="stat-number"><%= totalProducts %></span><span class="stat-label">Products</span></div></div>
      <div class="stat-card green"><i class="fas fa-receipt"></i><div><span class="stat-number"><%= totalOrders %></span><span class="stat-label">Orders</span></div></div>
      <div class="stat-card purple"><i class="fas fa-users"></i><div><span class="stat-number"><%= totalUsers %></span><span class="stat-label">Users</span></div></div>
      <div class="stat-card orange"><i class="fas fa-rupee-sign"></i><div><span class="stat-number">Rs. <%= revenue.toLocaleString() %></span><span class="stat-label">Revenue (Paid)</span></div></div>
    </div>

    <!-- Charts Row -->
    <div class="charts-row">
      <div class="chart-card" style="flex:2">
        <h3><i class="fas fa-chart-line"></i> Revenue — Last 7 Days</h3>
        <canvas id="revenueChart" height="120"></canvas>
      </div>
      <div class="chart-card" style="flex:1">
        <h3><i class="fas fa-chart-pie"></i> Sales by Category</h3>
        <canvas id="categoryChart" height="120"></canvas>
      </div>
    </div>

    <!-- Orders Chart -->
    <div class="chart-card" style="margin-bottom:1.5rem">
      <h3><i class="fas fa-chart-bar"></i> Orders — Last 7 Days</h3>
      <canvas id="ordersChart" height="80"></canvas>
    </div>

    <!-- Low Stock Alert -->
    <% if (lowStock && lowStock.length) { %>
    <div class="admin-section" style="margin-bottom:1.5rem">
      <div class="admin-section-header">
        <h2><i class="fas fa-exclamation-triangle" style="color:#f59e0b"></i> Low Stock Alert</h2>
        <a href="/admin/products" class="btn-outline btn-sm">Manage</a>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <% lowStock.forEach(p => { %>
          <div style="background:#fff8e1;border:1px solid #fbbf24;border-radius:8px;padding:.75rem 1rem;display:flex;align-items:center;gap:.75rem">
            <img src="<%= p.image %>" style="width:40px;height:40px;object-fit:cover;border-radius:6px" onerror="this.src='/images/placeholder.svg'"/>
            <div>
              <strong style="font-size:.9rem"><%= p.name %></strong><br/>
              <span style="color:<%= p.stock===0?'#ef4444':'#f59e0b' %>;font-weight:700"><%= p.stock === 0 ? 'OUT OF STOCK' : `${p.stock} left` %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Recent Orders Table -->
    <div class="admin-section">
      <div class="admin-section-header"><h2>Recent Orders</h2><a href="/admin/orders" class="btn-outline btn-sm">View All</a></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Order #</th><th>Customer</th><th>Total</th><th>Status</th><th>Payment</th><th>Date</th></tr></thead>
          <tbody>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td><code>#<%= order._id.toString().slice(-6).toUpperCase() %></code></td>
                <td><%= order.user?.name||'N/A' %></td>
                <td><strong>Rs. <%= order.totalAmount.toLocaleString() %></strong></td>
                <td><span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span></td>
                <td><span class="payment-badge payment-<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span></td>
                <td><%= new Date(order.createdAt).toLocaleDateString('en-PK') %></td>
              </tr>
            <% }) %>
            <% if (!recentOrders.length) { %><tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-light)">No orders yet</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const chartData    = <%- chartData %>;
const categoryData = <%- categoryData %>;
const labels   = chartData.map(d => d.date);
const revenues = chartData.map(d => d.revenue);
const orderCounts = chartData.map(d => d.orders);

// Revenue line chart
new Chart(document.getElementById('revenueChart'), {
  type: 'line',
  data: {
    labels,
    datasets: [{ label: 'Revenue (Rs.)', data: revenues, borderColor:'#6366f1', backgroundColor:'rgba(99,102,241,.1)', tension:.4, fill:true, pointBackgroundColor:'#6366f1', pointRadius:5 }]
  },
  options: { plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true, ticks:{ callback: v => 'Rs.'+v.toLocaleString() } } } }
});

// Orders bar chart
new Chart(document.getElementById('ordersChart'), {
  type: 'bar',
  data: {
    labels,
    datasets: [{ label: 'Orders', data: orderCounts, backgroundColor:'rgba(16,185,129,.7)', borderRadius:6 }]
  },
  options: { plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true, ticks:{ stepSize:1 } } } }
});

// Category pie chart
const COLORS = ['#6366f1','#10b981','#f59e0b','#ef4444','#3b82f6','#a855f7'];
new Chart(document.getElementById('categoryChart'), {
  type: 'doughnut',
  data: {
    labels: categoryData.map(c => c._id || 'Unknown'),
    datasets: [{ data: categoryData.map(c => c.revenue), backgroundColor: COLORS, borderWidth:2, borderColor:'#fff' }]
  },
  options: { plugins:{ legend:{ position:'bottom', labels:{ font:{ size:11 } } } }, cutout:'60%' }
});
</script>

<%- include('../partials/footer') %>
