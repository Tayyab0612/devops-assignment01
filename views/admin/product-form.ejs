<%- include('../partials/header', { title: product ? 'Edit Product' : 'Add Product' }) %>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-brand"><i class="fas fa-shield-alt"></i> Admin Panel</div>
    <nav class="admin-nav">
      <a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
      <a href="/admin/products" class="active"><i class="fas fa-box"></i> Products</a>
      <a href="/admin/orders"><i class="fas fa-receipt"></i> Orders</a>
      <a href="/products/admin/new"><i class="fas fa-plus"></i> Add Product</a>
      <a href="/"><i class="fas fa-store"></i> View Store</a>
    </nav>
  </aside>

  <div class="admin-content">
    <h1><%= product ? 'Edit Product' : 'Add New Product' %></h1>

    <form action="<%= product ? `/products/admin/${product._id}?_method=PUT` : '/products/admin' %>" method="POST" class="product-form-grid">

      <div class="form-col">
        <div class="form-section">
          <h3>Basic Info</h3>
          <div class="form-group"><label>Product Name *</label><input type="text" name="name" value="<%= product?.name||'' %>" required/></div>
          <div class="form-group"><label>Description *</label><textarea name="description" rows="4" required><%= product?.description||'' %></textarea></div>
          <div class="form-row">
            <div class="form-group"><label>Price (Rs.) *</label><input type="number" name="price" step="1" min="0" value="<%= product?.price||'' %>" required/></div>
            <div class="form-group"><label>Stock *</label><input type="number" name="stock" min="0" value="<%= product?.stock??0 %>" required/></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Category *</label>
              <select name="category" id="categorySelect" onchange="togglePlatform(this.value)" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>" <%= product?.category===cat?'selected':'' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group" id="platformGroup" style="display:<%= product?.category==='Games'?'block':'none' %>">
              <label>Platform</label>
              <select name="platform">
                <option value="">— Select —</option>
                <% platforms.forEach(p => { %>
                  <option value="<%= p %>" <%= product?.platform===p?'selected':'' %>><%= p %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-group"><label>Brand</label><input type="text" name="brand" value="<%= product?.brand||'Generic' %>"/></div>
          <div class="form-group"><label>Tags <small>(comma separated)</small></label><input type="text" name="tags" value="<%= product?.tags?.join(', ')||'' %>"/></div>
          <div class="form-group">
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
              <input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>/>
              Mark as Featured Product
            </label>
          </div>
        </div>
      </div>

      <div class="form-col">
        <div class="form-section">
          <h3>Images</h3>
          <div class="form-group">
            <label>Main Image URL *</label>
            <input type="url" name="image" value="<%= product?.image||'' %>" placeholder="https://..." oninput="previewMain(this.value)"/>
            <div style="margin-top:.5rem">
              <img id="mainPreview" src="<%= product?.image||'' %>" style="max-width:100%;max-height:180px;border-radius:8px;object-fit:cover;display:<%= product?.image?'block':'none' %>" onerror="this.style.display='none'"/>
            </div>
          </div>
          <div class="form-group">
            <label>Gallery Images <small>(one URL per line)</small></label>
            <textarea name="images" rows="5" placeholder="https://example.com/img1.jpg&#10;https://example.com/img2.jpg"><%= product?.images?.join('\n')||'' %></textarea>
            <small style="color:var(--text-light)">These appear as thumbnail gallery on the product page</small>
          </div>
        </div>
      </div>

      <div style="grid-column:1/-1;display:flex;gap:1rem;padding-top:.5rem">
        <button type="submit" class="btn-primary btn-lg"><i class="fas fa-save"></i> <%= product ? 'Save Changes' : 'Create Product' %></button>
        <a href="/admin/products" class="btn-outline btn-lg">Cancel</a>
        <% if (product) { %>
          <a href="/products/<%= product._id %>" class="btn-outline btn-lg" target="_blank"><i class="fas fa-eye"></i> Preview</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<script>
function togglePlatform(cat) {
  document.getElementById('platformGroup').style.display = cat === 'Games' ? 'block' : 'none';
}
function previewMain(url) {
  const img = document.getElementById('mainPreview');
  img.src = url;
  img.style.display = url ? 'block' : 'none';
  img.onerror = () => img.style.display = 'none';
}
</script>
<%- include('../partials/footer') %>
